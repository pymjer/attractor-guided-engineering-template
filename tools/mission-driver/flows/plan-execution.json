{
  "name": "plan-execution",
  "maxTotalSteps": 20,
  "maxCycleVisits": 8,
  "pingPongWindow": 6,
  "entry": "EXECUTE",

  "markerAliases": {
    "success": "pass",
    "ok": "pass",
    "done": "pass",
    "error": "fail",
    "failed": "fail"
  },

  "steps": {
    "EXECUTE": {
      "type": "agent",
      "promptPath": "prompts/execute.md",
      "onUnknownMaxRetries": 2,
      "timeoutMs": 1800000,
      "transitions": {
        "pass": { "goto": "CLOSURE_VERIFY" },
        "fail": { "retry": "EXECUTE", "maxRetries": 3 },
        "blocked": { "done": "blocked" }
      },
      "onMaxRetries": { "goto": "CLOSURE_VERIFY" },
      "onError": { "retry": "EXECUTE", "maxRetries": 3 }
    },

    "CLOSURE_VERIFY": {
      "type": "agent",
      "promptPath": "prompts/closure-verify.md",
      "maxRetries": 2,
      "onUnknownMaxRetries": 2,
      "timeoutMs": 1800000,
      "transitions": {
        "approved": { "done": "completed" },
        "blocked": { "done": "blocked" },
        "issues": {
          "retry": "EXECUTE",
          "maxRetries": 2,
          "append": {
            "extract": "REMAINING",
            "template": "\n\n## Closure Verify Feedback\n\nThe plan `{{PLAN_FILE}}` was independently verified and has real gaps. Go straight to these items; completed phases need no re-exploration:\n\n${output}"
          }
        }
      },
      "onMaxRetries": { "done": "failed" },
      "onError": { "retry": "CLOSURE_VERIFY", "maxRetries": 2 }
    }
  }
}
